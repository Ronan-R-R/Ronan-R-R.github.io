---
import Base from '../layouts/Base.astro'
import HeroScene from '../components/HeroScene.tsx'
import ContactForm from '../components/ContactForm.tsx'
import '../styles/global.css'

const nav = [
  { id: 'p-intro', label: 'Intro' },
  { id: 'p-about', label: 'About' },
  { id: 'p-work', label: 'Work' },
  { id: 'p-record', label: 'Record' },
  { id: 'p-contact', label: 'Contact' },
]

const skills = [
  { k: 'Languages', v: ['Java', 'C#', 'Python', 'JavaScript', 'SQL', 'Dart', 'Rust'] },
  { k: 'Web', v: ['HTML', 'CSS', 'Node.js', 'REST APIs'] },
  { k: 'Mobile', v: ['Flutter', 'Dart', 'Kivy'] },
  { k: 'Cloud / DB', v: ['Azure', 'Firebase'] },
  { k: 'Tools', v: ['Git', 'CI/CD', 'pytest', 'Agile', 'Async / network'] },
]

const projects = [
  { n: '01', title: 'FFP', desc: 'Fleet Failure Predictor - web dashboard, REST API, database, and an offline-first Flutter mobile app.', stack: ['Flutter', 'Dart', 'Firebase'], href: 'https://www.echosoftware.co.za/products/ffp' },
  { n: '02', title: 'BruvTorrent', desc: 'A BitTorrent client built from scratch in Python with a PySide6 desktop UI.', stack: ['Python', 'asyncio', 'PySide6'], href: 'https://github.com/Ronan-R-R/BruvTorrent' },
  { n: '03', title: 'yt-mp3', desc: 'Cross-platform audio downloader for desktop and Android, built via GitHub Actions.', stack: ['Python', 'Kivy', 'ffmpeg'], href: 'https://github.com/Ronan-R-R/yt-mp3' },
  { n: '04', title: 'Echo Software', desc: 'Live company website for a Pretoria-based software studio.', stack: ['HTML', 'CSS', 'JS'], href: 'https://echosoftware.co.za' },
  { n: '05', title: 'SkyCast', desc: 'Real-time weather dashboard with a 5-day forecast and interactive maps.', stack: ['JavaScript', 'OWM API', 'Leaflet'], href: 'https://ronan-r-r.github.io/SkyCast/' },
]

const record = [
  { year: '2026 -', role: 'Junior Software Engineer', org: 'Coast IT · Full-time' },
  { year: '2025', role: 'Junior Software Engineer', org: 'Coast IT · Internship' },
  { year: '2025', role: 'Intern', org: 'Open Vantage' },
  { year: '2025 - 26', role: 'Freelance Web Developer', org: 'Self-employed' },
  { year: '2023 -', role: 'Software Engineering (NQF 6)', org: 'CTU Training Solutions' },
  { year: '2021', role: 'National Senior Certificate', org: 'Bergsig Academy' },
]

const certs = [
  'Software Engineer NQF 6 - MICT SETA (2025)',
  'IT Systems Development NQF 5 - MICT SETA (2024)',
  'AI-900: Azure AI Fundamentals - Microsoft (2024)',
  'IT Systems Development NQF 4 - MICT SETA (2023)',
  'IT Specialist: JavaScript - Certiport (2023)',
  'IT Specialist: HTML & CSS - Certiport (2023)',
]
---

<Base>
  <div class="h-brand"><a href="#p-intro">RR<span style="color: var(--accent)">.</span></a></div>
  <nav class="h-nav">
    {nav.map(item => <button data-target={item.id}>{item.label}</button>)}
  </nav>

  <div class="h-outer" id="h-outer">
    <div class="h-track" id="h-track">

      <!-- Intro -->
      <section class="h-panel" id="p-intro">
        <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-8 items-center w-full">
          <div>
            <div class="h-eyebrow">Full-stack Developer - Germiston, ZA</div>
            <h1 class="h-title font-display font-bold">
              Ronan<br /><span class="gradient-text">Roberts</span>
            </h1>
            <p class="mt-6 text-lg leading-relaxed" style="color: var(--muted); max-width: 46ch">
              I build across the stack, web front-ends and back-ends in Java, C#,
              Python and Node.js, and cross-platform mobile in Flutter and Dart.
            </p>
            <div class="mt-8 h-eyebrow" style="color: var(--muted)">Scroll to move sideways →</div>
          </div>
          <div class="hidden lg:block h-[440px]" aria-hidden="true">
            <HeroScene client:only="react" />
          </div>
        </div>
      </section>

      <!-- About -->
      <section class="h-panel" id="p-about">
        <div class="h-eyebrow">01 - About</div>
        <h2 class="font-display font-bold mb-6" style="font-size: clamp(1.8rem, 4vw, 3rem); max-width: 20ch">
          I build the whole product, front to back.
        </h2>
        <p class="text-lg leading-relaxed mb-10" style="color: var(--muted); max-width: 60ch">
          Completing a Software Engineer qualification (NQF 6) with CTU, backed by MICT SETA
          and Microsoft certifications. Currently a Junior Software Engineer at Coast IT.
          Open to full-time, part-time, contract, and freelance work.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6" style="max-width: 1100px">
          {skills.map(g => (
            <div>
              <div class="h-eyebrow" style="color: var(--muted)">{g.k}</div>
              <ul class="flex flex-col gap-1.5">
                {g.v.map(s => <li class="text-sm" style="color: var(--text)">{s}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Work -->
      <section class="h-panel h-panel--auto" id="p-work">
        <div class="h-cards">
          <div class="flex flex-col justify-center pr-6" style="flex: 0 0 auto; max-width: 280px">
            <div class="h-eyebrow">02 - Work</div>
            <h2 class="font-display font-bold" style="font-size: clamp(2rem, 4vw, 3.4rem)">Selected<br />Work</h2>
            <p class="mt-4 text-sm" style="color: var(--muted)">Five projects across web, mobile, and full-stack.</p>
          </div>
          {projects.map(p => (
            <a class="h-card" href={p.href} target="_blank" rel="noopener noreferrer">
              <div class="preview-frame" style="height: 90px; border-radius: 10px; margin-bottom: auto; width: 100%"></div>
              <span class="h-card__num">{p.n}</span>
              <h3 class="font-display font-bold text-2xl">{p.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--muted)">{p.desc}</p>
              <div class="flex flex-wrap gap-2">{p.stack.map(s => <span class="stack-tag">{s}</span>)}</div>
            </a>
          ))}
        </div>
      </section>

      <!-- Record -->
      <section class="h-panel" id="p-record">
        <div class="h-eyebrow">03 - Record</div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-8 w-full" style="max-width: 1100px">
          <div>
            <h2 class="font-display font-bold mb-5" style="font-size: clamp(1.4rem, 3vw, 2rem)">Experience &amp; Education</h2>
            {record.map(r => (
              <div class="grid grid-cols-[5.5rem_1fr] gap-4 py-3" style="border-top: 1px solid var(--border)">
                <span class="text-xs font-semibold" style="color: var(--accent)">{r.year}</span>
                <span><span class="font-semibold block">{r.role}</span><span class="text-xs" style="color: var(--muted)">{r.org}</span></span>
              </div>
            ))}
          </div>
          <div>
            <h2 class="font-display font-bold mb-5" style="font-size: clamp(1.4rem, 3vw, 2rem)">Certifications</h2>
            {certs.map(c => (
              <div class="py-3 text-sm" style="border-top: 1px solid var(--border); color: var(--text)">{c}</div>
            ))}
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="h-panel" id="p-contact">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-12 lg:gap-20 w-full items-center">
          <div>
            <div class="h-eyebrow">04 - Contact</div>
            <h2 class="font-display font-bold leading-tight mb-8" style="font-size: clamp(2rem, 5vw, 3.6rem); max-width: 14ch">
              Let's work together.
            </h2>
            <div class="flex flex-col gap-3 text-sm">
              <a href="mailto:ronanr2003@gmail.com" class="ide-link w-fit" style="font-family: var(--mono)">ronanr2003@gmail.com</a>
              <a href="https://www.linkedin.com/in/rr-roberts/" target="_blank" rel="noopener noreferrer" class="ide-link w-fit" style="font-family: var(--mono)">linkedin.com/in/rr-roberts</a>
              <a href="https://github.com/Ronan-R-R" target="_blank" rel="noopener noreferrer" class="ide-link w-fit" style="font-family: var(--mono)">github.com/Ronan-R-R</a>
            </div>
          </div>
          <div style="max-width: 520px; width: 100%">
            <ContactForm client:visible />
          </div>
        </div>
      </section>

    </div>
  </div>

  <div class="h-hud" id="h-hud" aria-hidden="true">
    <span class="h-count"><b id="h-cur">01</b> / 05</span>
    <span class="h-hud__bar"><i id="h-bar"></i></span>
    <span id="h-label">Intro</span>
  </div>

  <style>
    .ide-link { color: var(--accent); border-bottom: 1px solid rgba(var(--accent-rgb),0.4); }
    .ide-link:hover { border-bottom-color: var(--accent); }
  </style>
</Base>
