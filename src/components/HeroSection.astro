---
import HeroScene from './HeroScene.tsx'

const marquee = [
  'Java', 'C#', 'Python', 'Node.js', 'Rust', 'JavaScript',
  'Flutter', 'Dart', 'SQL', 'Azure', 'REST APIs', 'Git',
]
---

<section id="hero" class="relative min-h-screen flex flex-col justify-center pt-24 overflow-hidden">

  <!-- Background aura -->
  <div
    id="hero-aura"
    class="absolute pointer-events-none select-none"
    aria-hidden="true"
    style="
      right: -8%;
      top: 42%;
      transform: translateY(-50%);
      width: min(760px, 88vw);
      height: min(760px, 88vw);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(var(--accent-rgb),0.16) 0%, rgba(var(--accent-rgb),0.04) 48%, transparent 70%);
    "
  ></div>

  <div class="container-wide w-full">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 xl:gap-16 items-center">

      <!-- Text content -->
      <div>
        <div class="section-tag" data-reveal>
          <span class="eyebrow-line"></span>
          Full-stack Developer
        </div>

        <h1
          class="font-display font-bold tracking-tight mb-7"
          style="font-size: clamp(3rem, 8.5vw, 6.8rem); line-height: 0.98"
          data-hero-title
        >
          <span class="hero-word">Full-stack.</span>
          <span class="hero-word gradient-text">Every</span>
          <span class="hero-word gradient-text">screen.</span>
        </h1>

        <p
          class="mb-9 leading-relaxed max-w-[560px]"
          style="color: var(--muted); font-size: 1.12rem"
          data-reveal
        >
          I build across the stack, web front-ends and back-ends in Java, C#,
          Python and Node.js, and cross-platform mobile apps in Flutter and Dart.
          Currently a Junior Software Engineer at Coast IT, completing my Software
          Engineer qualification (NQF 6) with CTU.
        </p>

        <div class="flex flex-wrap items-center gap-4 mb-8" data-reveal>
          <a href="#projects" class="btn-primary" data-magnetic>View work</a>
          <a href="#contact" class="btn-ghost" data-magnetic>Get in touch</a>
        </div>

        <div
          class="inline-flex items-center gap-2.5 text-sm"
          style="color: var(--muted)"
          data-reveal
        >
          <span class="relative flex h-2.5 w-2.5">
            <span
              class="absolute inline-flex h-full w-full rounded-full opacity-75"
              style="background: var(--accent); animation: hero-ping 1.8s cubic-bezier(0,0,0.2,1) infinite"
            ></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background: var(--accent)"></span>
          </span>
          Open to full-time, part-time, contract, and freelance work
        </div>
      </div>

      <!-- 3D scene -->
      <div class="relative h-[380px] md:h-[520px] lg:h-[600px]" aria-hidden="true">
        <HeroScene client:only="react" />
      </div>

    </div>
  </div>

  <!-- Skills marquee -->
  <div class="mt-16 lg:mt-20 py-5" style="border-top: 1px solid var(--border); border-bottom: 1px solid var(--border)">
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {marquee.map(item => <span class="marquee__item">{item}</span>)}
      </div>
      <div class="marquee__track">
        {marquee.map(item => <span class="marquee__item">{item}</span>)}
      </div>
    </div>
  </div>

</section>

<style>
  @keyframes hero-ping {
    75%, 100% { transform: scale(2.2); opacity: 0; }
  }
  .hero-word {
    display: inline-block;
  }
</style>
