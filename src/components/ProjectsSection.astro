---
interface ProjectLink {
  label: string
  href: string
  icon: 'globe' | 'github' | 'download' | 'external'
}

interface Project {
  title: string
  tagline: string
  description: string
  motif: string
  stack: string[]
  badge?: string
  links: ProjectLink[]
}

