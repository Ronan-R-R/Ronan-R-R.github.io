const projects: Project[] = [
  {
    title: 'FFP',
    tagline: 'Fleet Failure Predictor',
    description:
      'End-to-end fleet-management platform for trucking companies: web dashboard, REST API, database, and an offline-first Flutter mobile app with fuel-receipt OCR, trip tracking, and compliance monitoring. Built as one of two developers across front-end, back-end, database, and mobile.',
    motif: motifs.ffp,
    stack: ['Flutter', 'Dart', 'Firebase', 'REST API'],
    badge: 'Login required',
    links: [
      { label: 'Live app', href: 'https://trucking-predict.web.app', icon: 'external' },
      { label: 'Product page', href: 'https://www.echosoftware.co.za/products/ffp', icon: 'globe' },
    ],
  },
  {
    title: 'BruvTorrent',
    tagline: 'BitTorrent client from scratch',
    description:
      'A BitTorrent client built from scratch in Python with a PySide6 desktop UI, implementing the protocol by hand. Handles torrent files and magnet links, HTTP(S) and UDP trackers, seeding, resume with disk verification, and SHA-1 piece verification, backed by a pytest test suite.',
    motif: motifs.bruv,
    stack: ['Python', 'asyncio', 'PySide6'],
    links: [
      { label: 'Source', href: 'https://github.com/Ronan-R-R/BruvTorrent', icon: 'github' },
    ],
  },
  {
    title: 'yt-mp3',
    tagline: 'Cross-platform audio downloader',
    description:
      'A local audio downloader for desktop (Windows, Linux) and Android. Bundles ffmpeg for MP3 conversion on desktop and uses Kivy for the Android build, with automated multi-platform builds via GitHub Actions.',
    motif: motifs.ytmp3,
    stack: ['Python', 'Kivy', 'GitHub Actions', 'ffmpeg'],
    links: [
      { label: 'Source', href: 'https://github.com/Ronan-R-R/yt-mp3', icon: 'github' },
    ],
  },
  {
    title: 'Echo Software',
    tagline: 'Software studio website',
    description:
      'Live company website for Echo Software, a Pretoria-based software studio building custom digital products for clients.',
    motif: motifs.echo,
    stack: ['HTML', 'CSS', 'JavaScript'],
    links: [
      { label: 'Visit site', href: 'https://echosoftware.co.za', icon: 'globe' },
    ],
  },
  {
    title: 'SkyCast',
    tagline: 'Real-time weather dashboard',
    description:
      'Real-time weather dashboard with a 5-day forecast, interactive maps, and dynamic theming that shifts with live conditions.',
    motif: motifs.sky,
    stack: ['JavaScript', 'OpenWeatherMap API', 'Leaflet.js'],
    links: [
      { label: 'Live demo', href: 'https://ronan-r-r.github.io/SkyCast/', icon: 'globe' },
      { label: 'Source', href: 'https://github.com/Ronan-R-R/SkyCast', icon: 'github' },
    ],
  },
]

const [featured, ...rest] = projects

const icons = {
  globe: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  github: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
  download: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`,
  external: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`,
}
---

<section id="projects" class="py-28 lg:py-36">
  <div class="container-wide">

    <div class="mb-14" data-reveal>
      <div class="section-tag">
        <span class="eyebrow-line"></span>
        Work
      </div>
      <h2 class="h-display">Featured <span class="gradient-text">Projects</span></h2>
      <p class="mt-4 max-w-lg" style="color: var(--muted)">
        A selection of work across web, mobile, and full-stack engineering.
      </p>
    </div>

    <!-- Featured project -->
    <article
      class="card grid grid-cols-1 lg:grid-cols-2 overflow-hidden mb-5"
      data-reveal
    >
      <div class="preview-frame min-h-[240px] lg:min-h-[360px]" style="color: var(--accent)" set:html={featured.motif}></div>
      <div class="flex flex-col p-8 lg:p-10 gap-5 justify-center">
        <div class="flex items-center gap-3 flex-wrap">
          <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--accent)">{featured.tagline}</span>
          {featured.badge && (
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full" style="border: 1px solid var(--border); color: var(--muted)">{featured.badge}</span>
          )}
        </div>
        <h3 class="font-display font-bold" style="font-size: clamp(1.8rem, 3vw, 2.4rem)">{featured.title}</h3>
        <p class="leading-relaxed" style="color: var(--muted)">{featured.description}</p>
        <div class="flex flex-wrap gap-2">
          {featured.stack.map(tag => <span class="stack-tag">{tag}</span>)}
        </div>
        <div class="flex flex-wrap gap-5 pt-3" style="border-top: 1px solid var(--border)">
          {featured.links.map(link => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="proj-link inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--muted)">
              <Fragment set:html={icons[link.icon]} />{link.label}
            </a>
          ))}
        </div>
      </div>
    </article>

    <!-- Remaining projects -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {rest.map(project => (
        <article class="card flex flex-col overflow-hidden" data-tilt style="will-change: transform">
          <div class="preview-frame" style="height: 200px; flex-shrink: 0; color: var(--accent)">
            <div set:html={project.motif}></div>
            {project.badge && (
              <span class="absolute top-3 right-3 text-xs font-semibold px-2.5 py-1 rounded-full" style="background: rgba(var(--bg-rgb),0.7); border: 1px solid var(--border); color: var(--muted); backdrop-filter: blur(8px)">{project.badge}</span>
            )}
          </div>
          <div class="flex flex-col flex-1 p-6 gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-1.5" style="color: var(--accent)">{project.tagline}</p>
              <h3 class="font-display font-bold text-xl">{project.title}</h3>
            </div>
            <p class="text-sm leading-relaxed flex-1" style="color: var(--muted)">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.stack.map(tag => <span class="stack-tag">{tag}</span>)}
            </div>
            <div class="flex flex-wrap gap-4 pt-4" style="border-top: 1px solid var(--border)">
              {project.links.map(link => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="proj-link inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--muted)">
                  <Fragment set:html={icons[link.icon]} />{link.label}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .proj-link { transition: color 0.2s; }
  .proj-link:hover { color: var(--accent-2); }
</style>
