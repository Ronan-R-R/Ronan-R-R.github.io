---
const stats = [
  { value: 6, suffix: '', label: 'Certifications' },
  { value: 5, suffix: '', label: 'Featured projects' },
  { value: 14, suffix: '', label: 'Core technologies' },
  { value: null, text: 'NQF 6', label: 'Qualification' },
]

const groups = [
  { title: 'Languages', items: ['Java', 'C#', 'Python', 'JavaScript', 'SQL', 'Dart', 'Rust'] },
  { title: 'Web', items: ['HTML', 'CSS', 'Node.js', 'REST APIs'] },
  { title: 'Mobile', items: ['Flutter', 'Dart', 'Kivy'] },
  { title: 'Cloud & Databases', items: ['Azure', 'Firebase'] },
  { title: 'Tools & Practices', items: ['Git', 'CI/CD (GitHub Actions)', 'Unit testing (pytest)', 'Agile', 'Async & network programming'] },
]
---

<section id="about" class="py-28 lg:py-36">
  <div class="container-wide">

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.85fr] gap-14 lg:gap-20 items-start">

      <!-- Statement -->
      <div data-reveal>
        <div class="section-tag">
          <span class="eyebrow-line"></span>
          About
        </div>
        <h2 class="h-display mb-6">
          I build the whole product,<br class="hidden sm:block" />
          <span class="gradient-text">front to back.</span>
        </h2>
        <p class="leading-relaxed mb-5" style="color: var(--muted); font-size: 1.08rem; max-width: 560px">
          Full-stack developer based in Germiston. I work across web front-ends and
          back-ends in Java, C#, Python and Node.js, and cross-platform mobile apps
          in Flutter and Dart, from concept and UI through to database work and
          deployment.
        </p>
        <p class="leading-relaxed" style="color: var(--muted); font-size: 1.08rem; max-width: 560px">
          I'm completing a Software Engineer qualification (NQF 6) with CTU and hold
          a range of MICT SETA and Microsoft certifications. Open to full-time,
          part-time, contract, and freelance work.
        </p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-4" data-reveal-stagger>
        {stats.map(stat => (
          <div class="card p-6 flex flex-col gap-2">
            <div class="stat__num">
              {stat.value !== null ? (
                <span data-count={stat.value}>0</span>
              ) : (
                <span>{stat.text}</span>
              )}
              {stat.suffix}
            </div>
            <p class="text-sm font-medium" style="color: var(--muted)">{stat.label}</p>
          </div>
        ))}
      </div>

    </div>

    <!-- Skill groups -->
    <div class="mt-20 lg:mt-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-9" data-reveal-stagger>
        {groups.map(group => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.18em] mb-4" style="color: var(--accent)">
              {group.title}
            </h3>
            <div class="flex flex-wrap gap-2.5">
              {group.items.map(item => (
                <span class="chip"><span class="chip__dot"></span>{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
